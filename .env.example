# =============================================================================
# CBL Flexible Website — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Render note: most of these are set automatically by render.yaml.
# The only ones you must add manually in the Render dashboard are the
# three CLOUDINARY_* values and (after launch) your custom domain vars.
# =============================================================================


# -----------------------------------------------------------------------------
# Core Django
# -----------------------------------------------------------------------------

# Must be long, random, and secret in production.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Render sets this automatically via generateValue: true in render.yaml.
SECRET_KEY=change-me-use-the-command-above

# True for local development, False for production.
DEBUG=True

# Comma-separated list of allowed hostnames.
# Local dev: localhost and 127.0.0.1 are fine.
# Production (Render): .onrender.com covers all *.onrender.com subdomains.
# Add your custom domain here once you have one: mysite.com,www.mysite.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Which settings module to load.
# Use dev locally, prod on Render / any live server.
DJANGO_SETTINGS_MODULE=config.Settings.dev

# Python version hint for Render's build system.
PYTHON_VERSION=3.12


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Option A — single connection URL (Render, Heroku, Railway, etc.)
# Render injects this automatically from the linked PostgreSQL service.
# Leave blank for local dev and use the individual vars below instead.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Option B — individual vars (local PostgreSQL).
# These are ignored when DATABASE_URL is set.
DB_NAME=flexible_site
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432


# -----------------------------------------------------------------------------
# Cloudinary — required for ALL image uploads (logos, section images, OG images)
# -----------------------------------------------------------------------------
# Sign up free at https://cloudinary.com
# Dashboard → API Keys → copy Cloud name, API Key, API Secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# -----------------------------------------------------------------------------
# Security / CSRF
# -----------------------------------------------------------------------------

# Comma-separated list of trusted origins for cross-site requests (POST etc).
# Required in production when DEBUG=False.
# Render: https://*.onrender.com covers your *.onrender.com subdomain.
# Add your custom domain once you have one.
CSRF_TRUSTED_ORIGINS=https://*.onrender.com


# -----------------------------------------------------------------------------
# Email  (optional — defaults to console backend which logs to stdout)
# -----------------------------------------------------------------------------

# Console backend is fine for testing; switch to SMTP for real password resets.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server settings (only needed when using the SMTP backend above)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com


# -----------------------------------------------------------------------------
# Redis  (optional — improves caching performance with multiple workers)
# -----------------------------------------------------------------------------

# Leave blank to use Django's in-memory cache (works fine on a single dyno/instance).
# Add a Redis URL from Render, Railway, Upstash, etc. to get persistent caching.
# REDIS_URL=redis://default:password@host:6379


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO
