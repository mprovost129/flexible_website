# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# --- Required ---

# Generate a random string. Use: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production

# True for local development, False for production
DEBUG=True

# Comma-separated list of hosts/domains. For local dev, localhost is fine.
ALLOWED_HOSTS=localhost,127.0.0.1

# Use the dev settings locally, prod settings on your server.
DJANGO_SETTINGS_MODULE=config.Settings.dev

# --- Database ---
# Local development uses these individual values.
# Production (Render, Heroku) typically provides a single DATABASE_URL instead,
# which the project will use automatically if present.

DB_NAME=flexible_site
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Cloudinary (required for image uploads) ---
# Sign up free at cloudinary.com, then paste the three values from your dashboard.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional ---

# Trusted origins for CSRF (production only, comma-separated)
# Example: CSRF_TRUSTED_ORIGINS=https://yoursite.com,https://www.yoursite.com
CSRF_TRUSTED_ORIGINS=

# Email backend for password resets etc. Defaults to console (prints emails to stdout).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@yoursite.com

# Logging level
# DJANGO_LOG_LEVEL=INFO
