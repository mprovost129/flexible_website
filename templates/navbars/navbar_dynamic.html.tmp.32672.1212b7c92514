{% load static core_extras %}
{% comment %}
CBL universal navbar engine.

This replaces the old one-template-per-navbar approach. The five navbar
"options" are now presets stored in Site.navbar_variant; they should adjust
settings/data, not require separate markup files. Every feature can be placed
left, center, or right through Site Settings and NavLink.slot.
{% endcomment %}

{% with theme=site.navbar_theme nc=site.navbar_config_merged %}
<header class="cbl-navbar-shell {% if site.navbar_sticky %}sticky-top{% endif %} {% if site.navbar_shadow %}cbl-navbar-shadow{% endif %} cbl-navbar-{{ theme }} cbl-navbar-preset-{{ site.navbar_variant }} cbl-nav-links-{{ nc.link_style|default:'pill' }} cbl-nav-zones-{{ nc.zone_distribution|default:'balanced' }}"
        {% if nc.scroll_effect and nc.scroll_effect != 'none' %}data-scroll-effect="{{ nc.scroll_effect }}"{% endif %}
        style="
        --cbl-nav-bg: var(--cbl-chrome-bg, var(--bs-primary));
        --cbl-nav-text: var(--cbl-chrome-text, #ffffff);
        --cbl-nav-link: var(--cbl-chrome-link, currentColor);
        --cbl-nav-link-hover: var(--cbl-chrome-link-hover, currentColor);
        --cbl-nav-height: {{ nc.height_px|default:76 }}px;
        --cbl-nav-pad-x: {{ nc.padding_x|default:0 }}rem;
        --cbl-nav-pad-y: {{ nc.padding_y|default:0.4 }}rem;
        --cbl-nav-gap: {{ nc.gap_px|default:12 }}px;
        --cbl-nav-brand-size: {{ nc.brand_size_rem|default:1.6 }}rem;
        --cbl-nav-link-size: {{ nc.link_size_rem|default:1 }}rem;
        --cbl-nav-brand-weight: {{ nc.brand_weight|default:600 }};
        --cbl-nav-radius: {{ nc.radius_px|default:999 }}px;
        --cbl-nav-border-width: {{ nc.border_width_px|default:0 }}px;
        --cbl-nav-container-max: {{ nc.container_max_px|default:1320 }}px;
        {# Theme-driven shell colors are intentionally authoritative so theme
           switching visibly updates navbar/footer every time. #}
        ">
    <nav class="navbar navbar-expand-lg {% if theme == 'dark' or theme == 'primary' %}navbar-dark{% else %}navbar-light{% endif %}">
        <div class="{{ site.navbar_container }}">
            <div class="cbl-navbar-desktop w-100 d-none d-lg-grid align-items-center">
                <div class="cbl-navbar-zone cbl-navbar-left justify-content-start">
                    {% include "navbars/_navbar_slot.html" with site=site slot="left" %}
                </div>
                <div class="cbl-navbar-zone cbl-navbar-center justify-content-center">
                    {% include "navbars/_navbar_slot.html" with site=site slot="center" %}
                </div>
                <div class="cbl-navbar-zone cbl-navbar-right justify-content-end">
                    {% include "navbars/_navbar_slot.html" with site=site slot="right" %}
                </div>
            </div>

            <div class="cbl-navbar-mobile d-flex d-lg-none align-items-center justify-content-between w-100 gap-2">
                <div class="d-flex align-items-center gap-2">
                    {% include "navbars/_brand.html" with site=site %}
                </div>
                {% if nc.mobile_menu_style == 'offcanvas' %}
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#cblNavbarOffcanvas" aria-controls="cblNavbarOffcanvas" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                {% else %}
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#cblNavbarMenu" aria-controls="cblNavbarMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                {% endif %}
            </div>

            {% if nc.mobile_menu_style == 'offcanvas' %}
            <div class="offcanvas offcanvas-end cbl-navbar-offcanvas d-lg-none" tabindex="-1" id="cblNavbarOffcanvas" aria-labelledby="cblNavbarOffcanvasLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="cblNavbarOffcanvasLabel">{{ site.name|default:'Menu' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    {% if edit_mode_active %}
                    {# Mobile nav content intentionally hidden in edit mode to avoid duplicate editable controls. #}
                    {% else %}
                    <div class="d-flex flex-column gap-3">
                        {% include "navbars/_navbar_slot.html" with site=site slot="left" %}
                        {% include "navbars/_navbar_slot.html" with site=site slot="center" %}
                        {% include "navbars/_navbar_slot.html" with site=site slot="right" %}
                    </div>
                    {% endif %}
                </div>
            </div>
            {% else %}
            <div class="collapse cbl-navbar-mobile-menu d-lg-none mt-3" id="cblNavbarMenu">
                {% if edit_mode_active %}
                {# Mobile nav content intentionally hidden in edit mode to avoid duplicate editable controls. #}
                {% else %}
                <div class="d-flex flex-column gap-3">
                    {% include "navbars/_navbar_slot.html" with site=site slot="left" %}
                    {% include "navbars/_navbar_slot.html" with site=site slot="center" %}
                    {% include "navbars/_navbar_slot.html" with site=site slot="right" %}
                </div>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </nav>
</header>
{% endwith %}
